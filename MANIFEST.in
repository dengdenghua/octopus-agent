recursive-include runtime/sensing/gateway/agent_market_sources *
include skills.lock.json
# Ship the deterministic prompt-skill fallback inside wheels.  A clean checkout
# keeps the registry-managed skills/public catalog out of git, so excluding this
# package data makes an offline wheel silently register zero market skills.
recursive-include runtime/execution/all_skills *
recursive-exclude runtime/sensing/gateway/agent_market_sources __pycache__ *.py[cod]
recursive-exclude runtime/execution/all_skills __pycache__ *.py[cod]

{
  "name": "echo-android",
  "version": "1.0.0",
  "description": "按需启用 30 项安卓自动化接口：截图、点击、输入和设备操作。",
  "author": {
    "name": "EchoAI"
  },
  "interface": {
    "displayName": "安卓自动化",
    "shortDescription": "按需启用 30 项安卓自动化接口：截图、点击、输入和设备操作。",
    "longDescription": "按需启用 30 项安卓自动化接口：截图、点击、输入和设备操作。需要连接 Echo Android 客户端并授予设备操作权限。",
    "category": "Productivity",
    "capabilities": [
      "android.browser.click",
      "android.browser.evaluate",
      "android.browser.get_dom",
      "android.browser.install_extension",
      "android.browser.navigate",
      "android.browser.screenshot",
      "android.browser.type",
      "android.detect_dialog",
      "android.fail",
      "android.find_and_tap",
      "android.find_node",
      "android.find_text",
      "android.finish",
      "android.get_clipboard",
      "android.get_current_app",
      "android.get_installed_apps",
      "android.get_screen_info",
      "android.input_text",
      "android.install_app",
      "android.long_press",
      "android.open_app",
      "android.read_file",
      "android.scroll_to_find",
      "android.set_clipboard",
      "android.swipe",
      "android.system_key",
      "android.take_screenshot",
      "android.tap",
      "android.wait",
      "android.write_file"
    ],
    "logo": "./assets/icon.svg",
    "brandColor": "#34A853",
    "developerName": "EchoAI",
    "defaultPrompt": "连接设备并协助完成手机操作。"
  },
  "octopus": {
    "host_api": ">=0.2,<0.3",
    "permissions": [
      "content.read",
      "interaction.user"
    ],
    "auth_modes": [],
    "dependencies": [],
    "runtime_dependencies": []
  }
}

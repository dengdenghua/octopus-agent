# Copy to a private .env file and pass it with:
#   docker compose --env-file .env -f deploy/cloud-edge-compose.yml up -d --build
# Never commit the populated file.

# Three independent secrets. Generate each separately.
# These deliberately-short placeholders make the service fail closed if the
# operator forgets to replace them.
OCTOPUS_CLOUD_EDGE_TOKEN_SECRET=<CHANGE_ME>
OCTOPUS_CLOUD_EDGE_ADMIN_KEY=<CHANGE_ME>
OCTOPUS_CLOUD_REGISTRATION_CODE=<CHANGE_ME>
OCTOPUS_CLOUD_SHARE_RELAY_KEY=<CHANGE_ME>

OCTOPUS_CLOUD_EDGE_OWNER_ID=admin
OCTOPUS_CLOUD_EDGE_TENANT_ID=default

# Fixed HTTPS origin returned to desktop clients. No trailing slash.
OCTOPUS_PUBLIC_SHARE_BASE_URL=https://share.echo-age.com

# 30 days, 50 live shares per owner, 1 MiB per snapshot, 512 MiB total.
OCTOPUS_CLOUD_EDGE_SHARE_TTL_SECONDS=2592000
OCTOPUS_CLOUD_EDGE_SHARE_MAX_PER_OWNER=50
OCTOPUS_CLOUD_EDGE_SHARE_MAX_SNAPSHOT_BYTES=1048576
OCTOPUS_CLOUD_EDGE_SHARE_MAX_TOTAL_BYTES=536870912

# Keep the relay private behind the same-host reverse proxy.
OCTOPUS_CLOUD_EDGE_BIND_IP=127.0.0.1
OCTOPUS_CLOUD_EDGE_PORT=8090

[Unit]
Description=Octopus-Agent · biomimetic self-evolving agent OS
Documentation=https://github.com/octopus-agent/octopus-agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=octopus
Group=octopus
WorkingDirectory=/var/lib/octopus

# Implementation note.
EnvironmentFile=/etc/octopus/octopus.env

# Implementation note.
ExecStart=/opt/octopus-agent/.venv/bin/octopus-agent serve \
    --config /etc/octopus/config.yaml \
    --host 0.0.0.0 \
    --port 8000

Restart=on-failure
RestartSec=5s
StartLimitInterval=60s
StartLimitBurst=5

# Implementation note.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/octopus
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
PrivateDevices=true
CapabilityBoundingSet=

# Implementation note.
MemoryMax=2G
TasksMax=512

[Install]
WantedBy=multi-user.target

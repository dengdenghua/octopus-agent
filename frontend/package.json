{
  "name": "octopus-frontend",
  "version": "0.2.0",
  "description": "EchoAI — intelligent character platform powered by EchoOS",
  "author": "EchoOS Authors",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/octopus-agent/octopus-agent.git",
    "directory": "frontend"
  },
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "demo:save": "node scripts/save-demo.js",
    "build": "vite build",
    "build:report": "OCTOPUS_VISUALIZER=1 vite build",
    "check": "tsc --noEmit",
    "dev": "vite",
    "dev:full": "concurrently -k -n BACKEND,FRONTEND -c green,blue \"python -m runtime serve --config ../config.local.yaml --port 8000\" \"pnpm dev\"",
    "dev:full:example": "concurrently -k -n BACKEND,FRONTEND -c green,blue \"python -m runtime serve --config ../config.example.yaml --port 8000\" \"pnpm dev\"",
    "electron": "electron electron/main.cjs",
    "electron:dev": "concurrently -k -s first -n VITE,APP -c blue,magenta \"vite\" \"wait-on tcp:127.0.0.1:3000 && electron electron/main.cjs\"",
    "electron:dev:pet": "node scripts/dev-electron-with-pet.mjs",
    "codex:prepare:win": "node ../extras/desktop/prepare-codex-win.cjs",
    "codex:prepare:mac": "node ../extras/desktop/prepare-codex-mac.cjs",
    "codex:prepare:linux": "node ../extras/desktop/prepare-codex-linux.cjs",
    "electron:build:win": "pnpm build && pnpm codex:prepare:win && electron-builder --config ../packaging/desktop/build.yml --win --x64 --publish never",
    "electron:build:mac": "pnpm build && pnpm codex:prepare:mac && electron-builder --config ../packaging/desktop/build.yml --mac --arm64 --publish never",
    "electron:build:mac:x64": "pnpm build && OCTOPUS_MAC_ARCH=x64 pnpm codex:prepare:mac && electron-builder --config ../packaging/desktop/build.yml --mac --x64 --publish never",
    "electron:build:linux": "pnpm build && pnpm codex:prepare:linux && electron-builder --config ../packaging/desktop/build.yml --linux --x64 --publish never",
    "electron:build:linux:arm64": "pnpm build && OCTOPUS_LINUX_ARCH=arm64 pnpm codex:prepare:linux && electron-builder --config ../packaging/desktop/build.yml --linux --arm64 --publish never",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "preview": "vite preview",
    "start": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "bench": "vitest bench",
    "e2e": "playwright test --project=chromium",
    "e2e:cross-browser": "playwright test",
    "e2e:stream-ux": "playwright test e2e/stream-timeline-narrative.spec.ts --project=chromium",
    "e2e:full": "playwright test --config playwright.full.config.ts",
    "e2e:full:mobile": "cross-env OCTOPUS_E2E_TEST_MATCH=mobile-smoke.spec.ts playwright test --config playwright.full.config.ts --project chromium",
    "e2e:headed": "playwright test --headed",
    "e2e:ui": "playwright test --ui",
    "generate-types": "openapi-typescript ../docs/openapi-snapshot.json -o src/core/api/openapi-types.ts",
    "e2e:desktop": "playwright test --config playwright.electron.config.ts"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/merge": "^6.12.1",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.35.0",
    "@fontsource/inter": "^5.3.0",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@radix-ui/react-use-controllable-state": "^1.2.2",
    "@tanstack/react-query": "^5.90.17",
    "@uiw/codemirror-theme-basic": "^4.25.4",
    "@uiw/codemirror-theme-monokai": "^4.25.4",
    "@uiw/react-codemirror": "^4.25.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "ai": "^6.0.33",
    "best-effort-json-parser": "^1.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "codemirror": "^6.0.2",
    "date-fns": "^4.1.0",
    "diff": "^8.0.4",
    "dompurify": "^3.4.13",
    "embla-carousel-react": "^8.6.0",
    "idb": "^8.0.3",
    "katex": "^0.16.28",
    "lucide-react": "^0.562.0",
    "mermaid": "^11.16.1",
    "motion": "^12.26.2",
    "nanoid": "^5.1.16",
    "next-themes": "^0.4.6",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-resizable-panels": "^4.4.1",
    "react-router-dom": "^7.18.2",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shiki": "3.15.0",
    "sonner": "^2.0.7",
    "streamdown": "1.4.0",
    "tailwind-merge": "^3.4.0",
    "three": "^0.185.0",
    "unist-util-visit": "^5.0.0",
    "use-stick-to-bottom": "^1.1.1"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/eslintrc": "^3.3.1",
    "@fiahfy/ico": "^0.0.5",
    "@openai/codex": "0.149.0",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4.0.15",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/hast": "^3.0.4",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.4",
    "commitlint": "^21.2.1",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^39.8.10",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.9",
    "eslint": "^9.23.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.26",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "rollup-plugin-visualizer": "^7.0.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.0.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.27.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.4",
    "wait-on": "^8.0.1"
  },
  "ct3aMetadata": {
    "initVersion": "7.40.0"
  },
  "packageManager": "pnpm@10.26.2",
  "pnpm": {}
}

# octopus-agent · 环境变量示例
# 复制为 .env 后按需填写;未列出的变量均有内置默认值

# ═══════════════════════════════════════════════════════════
# LLM providers
# ═══════════════════════════════════════════════════════════
# Anthropic Claude API key(主对话模型提供商之一)
ANTHROPIC_API_KEY=
# 自定义 Anthropic 网关地址(可选,留空走官方端点)
ANTHROPIC_BASE_URL=
# OpenAI API key(GPT 系列模型;部分 skill 也会回退使用)
OPENAI_API_KEY=
# Google Gemini API key
GEMINI_API_KEY=
# 本地 Ollama 服务地址,例如 http://localhost:11434
OLLAMA_BASE_URL=

# Agnes AI —— 生图/生视频 skill 插件(agnes-image-generate / agnes-video-generate)使用
# 与对话模型(data/custom_models.json)共用同一个 key;未设置时回退到 OPENAI_API_KEY
AGNES_API_KEY=
# Agnes 网关地址(可选),默认 https://apihub.agnes-ai.com/v1
AGNES_BASE_URL=
# 生图模型(可选),默认 agnes-image-2.1-flash
AGNES_IMAGE_MODEL=
# 参考图(图生图)模型(可选);默认与生图模型一致,仅作显式覆盖的逃生口
AGNES_IMAGE_REFERENCE_MODEL=

# Volcano(火山方舟)—— 生图/生视频 skill 的首选 provider
# 配置后 agnes-image-generate / agnes-video-generate 优先走火山;未配置时才回退到 Agnes
VOLCENGINE_API_KEY=
# Agent Plan 套餐端点(默认即为该值)
VOLCENGINE_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
# 生图模型(可选),默认 doubao-seedream-5.0-lite
VOLCENGINE_IMAGE_MODEL=
# 生视频模型(可选),默认 doubao-seedance-1.5-pro
VOLCENGINE_VIDEO_MODEL=

# ═══════════════════════════════════════════════════════════
# Web search
# ═══════════════════════════════════════════════════════════
# 后端选择(可选):doubao | tavily | brave | serper | searxng | ddg
# 留空则按已配置的 API key 自动选择,全都没有时回落到 DDG HTML 抓取
WEB_SEARCH_BACKEND=

# 豆包搜索 —— 火山引擎为 AI Agent 构建的联网搜索 (每月 500 次免费)
# 开通 & 创建 Key: https://console.volcengine.com/search-infinity/web-search-exp
DOUBAO_SEARCH_API_KEY=

# Tavily —— https://tavily.com(面向 AI 的搜索)
TAVILY_API_KEY=

# Brave Search —— https://brave.com/search/api/(免费额度 2000 次/月)
BRAVE_API_KEY=

# Serper.dev —— https://serper.dev(Google 结果代理,按次付费)
SERPER_API_KEY=

# SearXNG —— 自建/公开实例的根 URL,例如 https://searx.example.com
# 可聚合 Google/Bing/百度/搜狗 等多个源
SEARXNG_URL=
SEARXNG_API_KEY=

# ═══════════════════════════════════════════════════════════
# Rerank (for research pipeline)
# ═══════════════════════════════════════════════════════════
# 后端选择(可选):bm25 | cohere。留空则有 COHERE_API_KEY 时走 cohere,否则 bm25
RERANK_BACKEND=

# Cohere Rerank v3 —— https://docs.cohere.com/reference/rerank
# 跨语言语义重排,不设就回落到本地 BM25
COHERE_API_KEY=

# ═══════════════════════════════════════════════════════════
# Server · 服务与运行时
# ═══════════════════════════════════════════════════════════
PORT=8000
LEARN_INTERVAL_S=0   # 0 = 关闭定时反思 · 3600 = 每小时一次

# ═══════════════════════════════════════════════════════════
# Paths · 路径覆盖(可选,留空走平台默认)
# ═══════════════════════════════════════════════════════════
# 数据目录直接覆盖(会话/记忆/技能等运行时数据)
# OCTOPUS_DATA_DIR=/data
# 运行时 home 目录;数据默认落在其下的 data 子目录
# OCTOPUS_HOME=
# 容器部署的配置文件路径(Dockerfile 中默认指向该路径)
# OCTOPUS_CONFIG=/etc/octopus/config.yaml
# 前端构建产物目录;设置后由后端直接托管 Web UI
# OCTOPUS_WEBUI_DIST=
# 浏览器扩展目录显式覆盖(默认使用仓库内置扩展)
# OCTOPUS_BROWSER_EXTENSION_DIR=
# Single-machine convenience: when ``octopus serve`` starts, also start and
# supervise the sibling ``octopus-storage`` service. This is not a macOS
# login-item; when Octopus launches it, storage stops with Octopus. Requires
# the sibling repository or an explicit ``OCTOPUS_STORAGE_CMD``.
# OCTOPUS_STORAGE_AUTOSTART=1
# OCTOPUS_STORAGE_CMD=/absolute/path/to/octopus-storage
# Operator-only switch: give each orchestration a token budget so its
# sub-agent fan-out scales to it (spawns = budget/8000, hard-capped at 256).
# Unset = conservative default (orchestration capped at 48 spawns). This is a
# deliberate, billable deployment decision — NOT settable by the model or end
# users. Example: 400000 → up to 50 spawns.
# OCTOPUS_ORCH_TOKEN_BUDGET=
# Deployment execution contract. Keep local for desktop/development. For a
# networked commercial service set commercial/shared/production/server; the
# serve command then requires a hard process sandbox and rejects soft/direct.
# Prefer the typed `execution:` block in config.yaml; these env vars are the
# emergency/operator override layer.
# OCTOPUS_DEPLOYMENT_MODE=commercial
# OCTOPUS_PROCESS_SANDBOX=strict
# 冒号分隔的提示词覆盖目录,优先级高于内置提示词
# OCTOPUS_PROMPT_DIRS=

# ═══════════════════════════════════════════════════════════
# Feature flags
# ═══════════════════════════════════════════════════════════
# 身份锁定:开启后禁止通过配置接口修改 agent 身份(0/false/off/no 关闭)
# OCTOPUS_IDENTITY_LOCK=false
# 后台自愈调度器(GEPA 变体 + 回滚),false 关闭
# OCTOPUS_REGEN_ENABLED=false
# 自愈调度器 tick 间隔(秒)
# OCTOPUS_REGEN_INTERVAL_SEC=600
# Camouflage 提示词进化循环(A/B 变体 + pareto 淘汰,实验特性)
# OCTOPUS_CAMOUFLAGE_ENABLED=false
# Camouflage 调度器 tick 间隔(秒)
# OCTOPUS_CAMOUFLAGE_INTERVAL_SEC=600
# 自动应用 GEPA 提出的提示词变体,跳过人工评审(实验特性,默认关)
# OCTOPUS_GEPA_AUTO_APPLY=false
# RecipeForge 自动晋升调度间隔(小时);默认关闭,设置后按该周期 tick
# OCTOPUS_FORGE_AUTO_PROMOTE_INTERVAL_HOURS=24
# 安全不变量执行(34 条宪法规则);设为 off 关闭,仅限调试
# OCTOPUS_INVARIANTS=strict

# ═══════════════════════════════════════════════════════════
# Security
# ═══════════════════════════════════════════════════════════
# channel 凭据加密密钥:base64 编码,解码后须为 32 字节
# OCTOPUS_CREDENTIAL_KEY=
# channel 状态文件路径,默认 data/channel_state.json
# OCTOPUS_CHANNEL_STATE=

# ═══════════════════════════════════════════════════════════
# docker-compose.full.yml · dependencies
# ═══════════════════════════════════════════════════════════
# Required by docker-compose.full.yml (redis + grafana services).
# Leave unset for `make up` / plain docker-compose.yml; set before `make up-full`.
REDIS_PASSWORD=change-me-redis
GRAFANA_PASSWORD=change-me-grafana

# ═══════════════════════════════════════════════════════════
# Observability · 链路追踪(可选)
# ═══════════════════════════════════════════════════════════
# OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318/v1/traces
# OTEL_SERVICE_NAME=octopus-agent

# ═══════════════════════════════════════════════════════════
# Logging
# ═══════════════════════════════════════════════════════════
# 日志级别:DEBUG / INFO / WARNING / ERROR
# OCTOPUS_LOG_LEVEL=INFO
# 日志格式;设为 json 或 structured 可启用结构化 JSON 日志
# OCTOPUS_LOG_FORMAT=%(asctime)s [%(levelname)s] %(name)s: %(message)s

# ═══════════════════════════════════════════════════════════
# Hearts · 多副本协调(RedisCoordinator,docker-compose.full.yml 使用)
# ═══════════════════════════════════════════════════════════
# OCTOPUS_HEARTS_REDIS_URL=redis://localhost:6379/0
